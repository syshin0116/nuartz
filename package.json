{
  "name": "nuartz-workspace",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "bun run prebuild && bun run --cwd apps/web dev",
    "prebuild": "bun scripts/prebuild.ts",
    "build": "bun run build:pkg && bun run prebuild && bun run build:app",
    "build:pkg": "bun run --cwd packages/nuartz build",
    "build:app": "bun run --cwd apps/web build",
    "typecheck": "bun run --cwd packages/nuartz typecheck && bun run --cwd apps/web typecheck",
    "test": "bun run --cwd packages/nuartz test",
    "validate": "bun run build:pkg && bun scripts/validate-content.ts",
    "check": "bun run build:pkg && bun run prebuild && bun run typecheck && bun run test && bun scripts/validate-content.ts"
  },
  "devDependencies": {
    "gray-matter": "^4.0.3",
    "nuartz": "workspace:*"
  },
  "version": "0.0.1",
  "packageManager": "bun@1.3.10",
  "overrides": {
    "js-yaml": "3.15.2",
    "postcss": "8.5.32",
    "vite": "7.3.7",
    "sharp": "0.35.5",
    "lodash-es": "4.18.1",
    "uuid": "11.1.1",
    "svgo": "3.3.5",
    "picomatch": "4.0.5",
    "esbuild": "0.28.2",
    "better-sqlite3": "12.11.1",
    "axios": "1.21.0"
  }
}
