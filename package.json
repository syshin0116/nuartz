{
  "name": "nuartz-workspace",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "bun run generate && bun run --cwd apps/web dev",
    "generate": "bun scripts/prebuild.ts",
    "build": "bun run build:pkg && bun run generate && bun run build:app",
    "build:static": "bun scripts/build-static.ts",
    "build:pkg": "bun run --cwd packages/nuartz build",
    "build:app": "bun run --cwd apps/web build",
    "typecheck": "bun run --cwd packages/nuartz typecheck && bun run --cwd apps/web typecheck",
    "test": "bun run --cwd packages/nuartz test",
    "validate": "bun run build:pkg && bun scripts/validate-content.ts",
    "check": "bun run build:pkg && bun run generate && bun run lint && bun run typecheck && bun run test:coverage && bun scripts/validate-content.ts --strict",
    "lint": "eslint . --max-warnings 0",
    "test:coverage": "bun run --cwd packages/nuartz test:coverage"
  },
  "devDependencies": {
    "eslint": "^9",
    "eslint-config-next": "16.4.4",
    "gray-matter": "^4.0.3",
    "nuartz": "workspace:*",
    "pagefind": "^1.5.2",
    "typescript": "npm:typescript@^6.0.2"
  },
  "version": "0.0.1",
  "packageManager": "bun@1.3.10",
  "overrides": {
    "js-yaml": "3.15.2",
    "postcss": "8.5.32",
    "vite": "7.3.7",
    "sharp": "0.35.5",
    "lodash-es": "4.18.1",
    "uuid": "11.1.1",
    "svgo": "3.3.5",
    "picomatch": "4.0.5",
    "esbuild": "0.28.2",
    "better-sqlite3": "12.11.1",
    "axios": "1.21.0"
  },
  "engines": {
    "node": ">=22.12"
  }
}
